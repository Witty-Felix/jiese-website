.page { min-height: 100vh; padding: 36rpx 28rpx 60rpx; box-sizing: border-box; }
.card { margin-bottom: 24rpx; padding: 30rpx; background: #fff; border: 1rpx solid #dce5e1; border-radius: 20rpx; box-shadow: 0 12rpx 36rpx rgba(31, 52, 45, .06); }
.login-card { margin-top: 96rpx; }
.eyebrow { color: #0f6e56; font-size: 22rpx; font-weight: 700; letter-spacing: 3rpx; }
.title { color: #17211e; font-size: 40rpx; font-weight: 700; line-height: 1.25; }
.login-card .title { margin-top: 12rpx; }
.subtitle { margin-top: 8rpx; color: #68746f; font-size: 26rpx; line-height: 1.5; }
.label { margin: 34rpx 0 12rpx; color: #17211e; font-size: 27rpx; font-weight: 600; }
.input, .textarea { width: 100%; box-sizing: border-box; border: 1rpx solid #c3d0cb; border-radius: 12rpx; background: #fbfdfc; color: #17211e; font-size: 28rpx; }
.input { height: 88rpx; padding: 0 22rpx; }
.textarea { min-height: 190rpx; padding: 18rpx 22rpx; }
.primary, .secondary, .select-button { border: 0; font-size: 28rpx; }
.primary { margin-top: 30rpx; color: #fff; background: #0f6e56; }
.primary::after, .secondary::after, .select-button::after { border: 0; }
.primary.small { margin-top: 0; flex: 1; }
.secondary { margin-top: 0; color: #0f6e56; background: #e1f5ee; flex: 1; }
.topbar { display: flex; align-items: center; justify-content: space-between; margin: 0 4rpx 28rpx; }
.topbar .title { font-size: 38rpx; }
.link-button { margin: 0; padding: 0 8rpx; color: #0f6e56; background: transparent; font-size: 25rpx; }
.section-title { color: #17211e; font-size: 31rpx; font-weight: 700; }
.optional { color: #68746f; font-size: 24rpx; font-weight: 400; }
.hint { margin-top: 10rpx; color: #68746f; font-size: 25rpx; line-height: 1.55; }
.select-button { margin-top: 24rpx; color: #0f6e56; background: #e1f5ee; }
.picked { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-top: 20rpx; padding: 18rpx; border: 1rpx solid #b6dcc7; border-radius: 12rpx; background: #f4fbf8; }
.picked-main { min-width: 0; flex: 1; }
.picked-name { overflow: hidden; color: #17211e; font-size: 27rpx; text-overflow: ellipsis; white-space: nowrap; }
.picked-meta { margin-top: 5rpx; color: #68746f; font-size: 22rpx; }
.remove-button { flex: none; margin: 0; padding: 0 12rpx; color: #a32d2d; background: transparent; font-size: 23rpx; }
.counter { margin-top: 8rpx; color: #93a09a; text-align: right; font-size: 22rpx; }
.notice { margin: 20rpx 0; padding: 20rpx; border-radius: 12rpx; font-size: 25rpx; line-height: 1.55; }
.pending-notice { color: #07513f; background: #e1f5ee; }
.error-notice { color: #8e2727; background: #fcebeb; }
.success-notice { color: #07513f; background: #e1f5ee; }
.confirm { border-color: #f0d8ad; background: #fffaf0; }
.confirm-title { color: #8b5e00; font-size: 29rpx; font-weight: 700; }
.confirm-actions { display: flex; gap: 18rpx; margin-top: 22rpx; }
.confirm-actions button { padding: 0 18rpx; }
.submit { width: 100%; }
.footnote { padding: 24rpx 8rpx 0; color: #93a09a; text-align: center; font-size: 21rpx; }
